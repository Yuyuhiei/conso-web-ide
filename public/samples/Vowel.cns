mn() {
    chr ch;

    ch = npt("Enter a letter: ");   
     
    f((ch == 'a') || (ch == 'e') || (ch == 'i') || (ch == 'o') || (ch == 'u') ||
        (ch == 'A') || (ch == 'E') || (ch == 'I') || (ch == 'O') || (ch == 'U')) {
        prnt(ch, "is a vowel.\n");   
    }lsf (   
        (ch == 'b') || (ch == 'c') || (ch == 'd') || (ch == 'f') || (ch == 'g') ||
        (ch == 'h') || (ch == 'j') || (ch == 'k') || (ch == 'l') || (ch == 'm') ||
        (ch == 'n') || (ch == 'p') || (ch == 'q') || (ch == 'r') || (ch == 's') ||
        (ch == 't') || (ch == 'v') || (ch == 'w') || (ch == 'x') || (ch == 'y') || (ch == 'z') ||
        (ch == 'B') || (ch == 'C') || (ch == 'D') || (ch == 'F') || (ch == 'G') ||
        (ch == 'H') || (ch == 'J') || (ch == 'K') || (ch == 'L') || (ch == 'M') || 
        (ch == 'N') || (ch == 'P') || (ch == 'Q') || (ch == 'R') || (ch == 'S') ||
        (ch == 'T') || (ch == 'V') || (ch == 'W') || (ch == 'X') || (ch == 'Y') || (ch == 'Z')
    ) {
        prnt(ch, "is not a vowel.\n"); 
    }ls{  
        prnt("The character is not a letter.\n");
    }
 
    end;
}