mn() { 
    nt num1, num2, gcd = 1;
    nt i = 1; 
    nt done = 0;

    # Input two numbers 
    num1 = npt("Enter the first number: "); 
    num2 = npt("Enter the second number: "); 

    # Find GCD using iteration
    whl (done == 0) {
        f ((i <= num1) && (i <= num2)) {
            f ((num1 % i == 0) && (num2 % i == 0)) {
                gcd = i;
            } 
            i++;
        }ls{ 
            done = 1;
        } 
    } 
    prnt("GCD of", num1, "and", num2, "is", gcd);
    end; 
}
