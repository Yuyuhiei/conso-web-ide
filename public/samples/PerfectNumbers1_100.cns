mn() {
    nt i, j, sum; 
  
    prnt("Perfect numbers from 1 to 100:", "\n");    
 
    fr(i = 1; i <= 100; i++) {          
        sum = 0;        
          
        # Find the sum of proper divisors         
        fr (j = 1; j < i; j++) {     
            f (i % j == 0) {       
                sum += j;    
            } 
        }  

        # Check if the number is perfect
        f (sum == i) {
            prnt(i, " "); 
        }
    }

    prnt("\n");

    end; 
}
 